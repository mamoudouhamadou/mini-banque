# Variables pour « docker compose -f compose.prod.yaml ». Copier en .env (jamais commité) et remplir.

# Clé qui signe les jetons JWT (32 caractères minimum). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# Facultatif : port local de l'application (par défaut 8083)
# PORT_APP=8083

# Facultatif : certificat racine d'un antivirus ou d'un proxy qui inspecte le HTTPS
# Avast : C:/ProgramData/Avast Software/Avast/wscert.pem
# CA_SUPPLEMENTAIRE="C:/chemin/vers/certificat-racine.pem"
